  "html": "<!DOCTYPE html>\r\n<html lang=\"zh-CN\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\r\n<title>PK赛实时通报</title>\r\n<style>\r\n* { margin: 0; padding: 0; box-sizing: border-box; }\r\n:root {\r\n  --primary: #3b82f6;\r\n  --primary-dark: #1d4ed8;\r\n  --primary-light: #dbeafe;\r\n  --purple: #8b5cf6;\r\n  --header-blue: #1a4b8c;\r\n  --slate-50: #f8fafc;\r\n  --slate-100: #f1f5f9;\r\n  --slate-200: #e2e8f0;\r\n  --slate-300: #cbd5e1;\r\n  --slate-400: #94a3b8;\r\n  --slate-500: #64748b;\r\n  --slate-600: #475569;\r\n  --slate-700: #334155;\r\n  --slate-800: #1e293b;\r\n  --radius: 12px;\r\n  --shadow: 0 2px 12px rgba(0,0,0,0.06);\r\n}\r\nbody { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; background: var(--slate-50); color: var(--slate-800); font-size: 14px; -webkit-tap-highlight-color: transparent; }\r\n\r\n/* 顶部头部 */\r\n.header { background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 50%, #8b5cf6 100%); color: #fff; padding: 20px 16px 16px; position: sticky; top: 0; z-index: 100; box-shadow: 0 4px 16px rgba(29,78,216,0.25); }\r\n.header .title { font-size: 22px; font-weight: 700; text-align: center; letter-spacing: 1px; }\r\n.header .date-time-line { font-size: 14px; text-align: center; margin-top: 6px; font-weight: 500; opacity: 0.95; }\r\n.header .info-bar { display: flex; justify-content: center; gap: 12px; margin-top: 10px; }\r\n.header .info-chip { background: rgba(255,255,255,0.2); padding: 3px 12px; border-radius: 20px; font-size: 12px; backdrop-filter: blur(4px); }\r\n\r\n.container { max-width: 1100px; margin: 0 auto; padding: 12px; }\r\n\r\n/* tab切换 */\r\n.tabs { display: flex; gap: 8px; margin-bottom: 12px; }\r\n.tab { padding: 10px 24px; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--slate-500); background: #fff; border-radius: var(--radius); border: 1px solid var(--slate-200); transition: all 0.2s; flex: 1; text-align: center; }\r\n.tab:hover { border-color: var(--primary); color: var(--primary); }\r\n.tab.active { background: linear-gradient(135deg, var(--primary), var(--purple)); color: #fff; border-color: transparent; box-shadow: 0 2px 8px rgba(59,130,246,0.3); }\r\n.tab-content { display: none; }\r\n.tab-content.active { display: block; animation: fadeIn 0.3s ease; }\r\n@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\r\n\r\n/* 折叠控制 */\r\n.controls { display: flex; justify-content: center; gap: 10px; margin-bottom: 12px; }\r\n.controls button { padding: 7px 20px; border: 1px solid var(--slate-200); background: #fff; color: var(--slate-600); border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.2s; }\r\n.controls button:hover { background: var(--primary); color: #fff; border-color: var(--primary); }\r\n\r\n/* ─── 表格 —— 左侧名称列sticky固定，右侧数据列滑动 ─── */\r\n.report-card { width: 100%; background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid var(--slate-100); overflow: hidden; margin-bottom: 10px; }\r\n.report-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }\r\n.report-table { width: 100%; min-width: 520px; border-collapse: collapse; table-layout: auto; }\r\n\r\n/* 表头 */\r\n.report-table thead .row-header { background: var(--header-blue); color: #fff; font-weight: 600; }\r\n.report-table thead th { padding: 10px 6px; text-align: center; white-space: nowrap; font-size: 13px; border: none; }\r\n.report-table thead th.col-name { text-align: left; padding-left: 16px; position: sticky; left: 0; z-index: 20; background: var(--header-blue); }\r\n\r\n/* 数据单元格（公共） */\r\n.report-table td { padding: 8px 6px; text-align: center; white-space: nowrap; font-size: 13px; border: none; }\r\n.report-table td.col-name { text-align: left; padding-left: 16px; font-weight: 500; color: #333; white-space: nowrap; position: sticky; left: 0; z-index: 10; }\r\n.report-table td.num-val { color: #333; font-weight: 500; }\r\n.report-table td.num-zero { color: #ccc; }\r\n\r\n/* 可折叠行 */\r\n.report-table tr.clickable { cursor: pointer; transition: background 0.15s; user-select: none; }\r\n.report-table tr.clickable:hover { background: var(--slate-50); }\r\n.report-table tr.clickable:hover td.col-name { background: var(--slate-50); }\r\n.arrow { display: inline-block; width: 7px; height: 7px; border-right: 2px solid var(--slate-400); border-bottom: 2px solid var(--slate-400); transform: rotate(-45deg); transition: transform 0.2s; margin-right: 8px; flex-shrink: 0; }\r\ntr.expanded .arrow { transform: rotate(45deg); }\r\n\r\n/* 区县行（第一层）—— 醒目 */\r\ntr.row-district { border-bottom: 2px solid var(--slate-200); }\r\ntr.row-district { background: linear-gradient(135deg, #eff6ff, #f0f7ff); }\r\ntr.row-district td.col-name { font-size: 16px; font-weight: 700; color: var(--primary-dark); background: linear-gradient(135deg, #eff6ff, #f0f7ff); }\r\ntr.row-district td.num-val { font-weight: 700; color: var(--primary-dark); font-size: 15px; }\r\ntr.row-district td.num-zero { color: var(--slate-300); }\r\n\r\n/* 让胡路区行（顶层）—— 最醒目 */\r\ntr.row-city { background: linear-gradient(135deg, #eff6ff, #f0f7ff); }\r\ntr.row-city td.col-name { font-size: 18px; font-weight: 700; color: var(--primary-dark); background: linear-gradient(135deg, #eff6ff, #f0f7ff); }\r\ntr.row-city td.num-val { font-weight: 700; color: var(--primary-dark); font-size: 16px; }\r\ntr.row-city td.num-zero { color: var(--slate-300); }\r\n\r\n/* 支局行（第二层）—— 中等 */\r\ntr.row-branch { border-bottom: 1px solid var(--slate-100); }\r\ntr.row-branch { background: #fafbfc; }\r\ntr.row-branch td.col-name { font-size: 14px; font-weight: 600; color: var(--slate-700); padding-left: 32px; background: #fafbfc; }\r\ntr.row-branch td.num-val { font-weight: 600; color: var(--slate-700); }\r\ntr.row-branch td.num-zero { color: var(--slate-300); }\r\n\r\n/* 门店行（第三层）—— 淡化 */\r\ntr.row-store { border-bottom: 1px solid #f0f0f0; }\r\ntr.row-store { background: #fff; }\r\ntr.row-store:hover { background: #f5f9ff; }\r\ntr.row-store:hover td.col-name { background: #f5f9ff; }\r\ntr.row-store td.col-name { font-size: 13px; font-weight: 400; color: var(--slate-500); padding-left: 48px; background: #fff; }\r\ntr.row-store td.num-val { font-weight: 400; color: var(--slate-600); }\r\ntr.row-store td.num-zero { color: var(--slate-200); }\r\n\r\n.empty-tip { text-align: center; padding: 40px; color: var(--slate-400); }\r\n\r\n::-webkit-scrollbar { width: 6px; height: 6px; }\r\n::-webkit-scrollbar-thumb { background: var(--slate-300); border-radius: 3px; }\r\n::-webkit-scrollbar-track { background: var(--slate-100); }\r\n\r\n@media (max-width: 768px) {\r\n  .header .title { font-size: 18px; }\r\n  .header .date-time-line { font-size: 13px; }\r\n  .container { padding: 8px; }\r\n  .report-table td { padding: 6px 3px; font-size: 12px; }\r\n  .report-table td.col-name { padding-left: 10px; }\r\n  .report-table thead th { padding: 8px 3px; font-size: 12px; }\r\n  .report-table thead th.col-name { padding-left: 10px; }\r\n  tr.row-district td.col-name { font-size: 14px; }\r\n  tr.row-district td.num-val { font-size: 13px; }\r\n  tr.row-city td.col-name { font-size: 15px; }\r\n  tr.row-city td.num-val { font-size: 14px; }\r\n  tr.row-branch td.col-name { padding-left: 22px; }\r\n  tr.row-store td.col-name { padding-left: 34px; }\r\n  .report-table { min-width: 420px; }\r\n}\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"header\">\r\n  <div class=\"title\">PK赛实时通报</div>\r\n  <div class=\"date-time-line\">2026年09月05日 70:00</div>\r\n  <div class=\"info-bar\">\r\n    <span class=\"info-chip\">共0条门店数据</span>\r\n  </div>\r\n</div>\r\n<div class=\"container\">\r\n  <div class=\"controls\">\r\n    <button onclick=\"expandAll()\">全部展开</button>\r\n    <button onclick=\"collapseAll()\">全部折叠</button>\r\n  </div>\r\n\r\n  <div class=\"tabs\">\r\n    <div class=\"tab active\" onclick=\"switchTab('tab-dq', this)\">大庆市</div>\r\n    <div class=\"tab\" onclick=\"switchTab('tab-rlh', this)\">让胡路区</div>\r\n  </div>\r\n\r\n  <div class=\"tab-content active\" id=\"tab-dq\">\r\n    <div class=\"report-card\">\r\n      <div class=\"report-scroll\">\r\n        <table class=\"report-table\">\r\n\r\n<thead><tr class=\"row-header\"><th class=\"col-name\">门店名称</th><th class=\"col-metric\">移动</th><th class=\"col-metric\">宽带</th><th class=\"col-metric\">高清</th><th class=\"col-metric\">橙分期</th><th class=\"col-metric\">FTTR</th></tr></thead>\r\n<tbody>\r\n        </tbody>\r\n        </table>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"tab-content\" id=\"tab-rlh\">\r\n    <div class=\"report-card\">\r\n      <div class=\"report-scroll\">\r\n        <table class=\"report-table\">\r\n\r\n        </tbody>\r\n        </table>\r\n      </div>\r\n    </div>\r\n    <div class=\"empty-tip\">暂无让胡路区/乘风区数据</div>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\nfunction toggleNode(id) {\r\n  var row = document.querySelector('tr[data-id=\"' + id + '\"]');\r\n  if (!row) return;\r\n  var expanded = row.classList.toggle('expanded');\r\n  if (expanded) {\r\n    showChildren(id);\r\n  } else {\r\n    hideDescendants(id);\r\n  }\r\n}\r\n\r\nfunction hideDescendants(id) {\r\n  document.querySelectorAll('tr[data-parent=\"' + id + '\"]').forEach(function(child) {\r\n    child.style.display = 'none';\r\n    var cid = child.getAttribute('data-id');\r\n    if (cid) hideDescendants(cid);\r\n  });\r\n}\r\n\r\nfunction showChildren(id) {\r\n  document.querySelectorAll('tr[data-parent=\"' + id + '\"]').forEach(function(child) {\r\n    child.style.display = '';\r\n    if (child.classList.contains('expanded')) {\r\n      var cid = child.getAttribute('data-id');\r\n      if (cid) showChildren(cid);\r\n    }\r\n  });\r\n}\r\n\r\nfunction expandAll() {\r\n  document.querySelectorAll('tr.clickable').forEach(function(r) { r.classList.add('expanded'); });\r\n  document.querySelectorAll('tbody tr').forEach(function(r) { r.style.display = ''; });\r\n}\r\n\r\nfunction collapseAll() {\r\n  document.querySelectorAll('tr.clickable').forEach(function(r) { r.classList.remove('expanded'); });\r\n  document.querySelectorAll('tbody tr[data-parent]').forEach(function(r) { r.style.display = 'none'; });\r\n}\r\n\r\nfunction switchTab(id, el) {\r\n  document.querySelectorAll('.tab').forEach(function(t) { t.classList.remove('active'); });\r\n  document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });\r\n  el.classList.add('active');\r\n  document.getElementById(id).classList.add('active');\r\n}\r\n</script>\r\n</body>\r\n</html>",
  "title": "PK赛实时通报 - 2026年09月05日",
